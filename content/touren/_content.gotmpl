{{- /* Legt für jede Tour aus data/gpx.json (erzeugt von scripts/strava_gpx.py) eine Seite an.
     Titel, Text und Foto kommen optional aus data/touren.yaml (Schlüssel = Strava-ID). */ -}}
{{- .EnableAllLanguages -}}
{{- $lang := .Site.Language.Lang -}}
{{- $extra := .Site.Data.touren | default dict -}}
{{- /* Geplante Routen (data/geplant.json, scripts/plan_route.py) laufen mit: noch nicht gefahren, Zahlen aus der Planung. */ -}}
{{- $all := .Site.Data.gpx.tours | default slice -}}
{{- with .Site.Data.geplant }}{{ range .tours }}{{ $all = $all | append . }}{{ end }}{{ end -}}
{{- range $all -}}
  {{- $info := index $extra .id | default dict -}}
  {{- $title := .name -}}
  {{- with $info.title }}{{ $title = . }}{{ end -}}
  {{- if eq $lang "en" }}{{ with $info.title_en }}{{ $title = . }}{{ end }}{{ end -}}
  {{- $text := $info.text | default "" -}}
  {{- $ground := $info.untergrund | default "" -}}
  {{- if eq $lang "en" }}{{ with $info.untergrund_en }}{{ $ground = . }}{{ end }}{{ end -}}
  {{- if eq $lang "en" }}{{ with $info.text_en }}{{ $text = . }}{{ end }}{{ end -}}
  {{- $slug := $info.slug | default .slug | default (printf "%s-%s" .date .id) -}}
  {{- $.AddPage (dict
        "kind" "page"
        "path" $slug
        "title" $title
        "dates" (dict "date" (time .date))
        "summary" (cond (and (eq $lang "en") $info.summary_en) $info.summary_en ($info.summary | default ""))
        "content" (dict "mediaType" "text/markdown" "value" $text)
        "params" (dict "tour" . "photo" ($info.photo | default "") "photo_kind" ($info.photo_kind | default "") "photo_alt" ($info.photo_alt | default $title) "gallery" ($info.gallery | default slice) "untergrund" $ground "described" (ne $text ""))
      ) -}}
{{- end -}}
